<mujoco model="cerberus_arm_3dof_manipulator">
  <compiler angle="radian" coordinate="local" meshdir="meshes" autolimits="true"/>
  
  <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81">
    <flag contact="enable"/>
  </option>

  <default>
    <joint damping="0.6" armature="0.03"/>
    <geom friction="1.2 0.005 0.0001" density="1200"/>
  </default>

  <visual>
    <headlight ambient="0.32 0.35 0.40" diffuse="0.75 0.78 0.85" specular="0.35 0.35 0.35"/>
    <rgba haze="0.1 0.12 0.15 1"/>
  </visual>

  <asset>
    <!-- Industrial Optical Workcell Grid Floor -->
    <texture name="grid_floor" type="2d" builtin="checker" width="512" height="512" rgb1="0.07 0.09 0.13" rgb2="0.04 0.06 0.09"/>
    <material name="mat_floor" texture="grid_floor" texrepeat="8 8" reflectance="0.2" roughness="0.5"/>
    
    <!-- Robot Link Materials -->
    <material name="mat_carbon" rgba="0.10 0.12 0.16 1" metallic="0.85" roughness="0.25"/>
    <material name="mat_titanium" rgba="0.70 0.75 0.80 1" metallic="0.95" roughness="0.15"/>
    <material name="mat_joint_cyan" rgba="0.02 0.75 0.90 1" emission="0.35"/>
    <material name="mat_joint_accent" rgba="0.96 0.75 0.10 1" emission="0.25"/>
    
    <!-- Industrial Sorting Bays -->
    <material name="mat_bay_a" rgba="0.94 0.25 0.25 0.55" emission="0.3"/> <!-- SMT Staging -->
    <material name="mat_bay_b" rgba="0.20 0.55 0.98 0.55" emission="0.3"/> <!-- AOI Inspection -->
    <material name="mat_bay_c" rgba="0.08 0.78 0.55 0.55" emission="0.3"/> <!-- Cleanroom QA -->
    <material name="mat_laser_curtain" rgba="0.95 0.60 0.10 0.45" emission="0.5"/>

    <!-- Component Materials -->
    <material name="mat_obj_crimson" rgba="0.94 0.25 0.25 1" specular="0.85" roughness="0.2"/>
    <material name="mat_obj_cobalt" rgba="0.20 0.55 0.98 1" specular="0.85" roughness="0.2"/>
    <material name="mat_obj_emerald" rgba="0.08 0.78 0.55 1" specular="0.85" roughness="0.2"/>
    <material name="mat_obj_amber" rgba="0.96 0.65 0.05 1" specular="0.85" roughness="0.2"/>
  </asset>

  <worldbody>
    <!-- Precision Optical Breadboard Surface -->
    <geom name="floor" type="plane" size="3.5 3.5 0.1" material="mat_floor"/>
    
    <!-- Studio Overhead & Key Lights -->
    <light directional="true" pos="2 2 4.5" dir="-0.5 -0.5 -1" diffuse="0.85 0.9 0.95" specular="0.5 0.5 0.5"/>
    <light directional="true" pos="-2.5 -1.5 3.0" dir="0.8 0.5 -0.8" diffuse="0.35 0.4 0.45"/>

    <!-- Industrial Sorting Station Bays -->
    <!-- Bay A: SMT Assembly Staging -->
    <body name="bay_a_red" pos="-1.25 0.45 0.02">
      <geom type="cylinder" size="0.22 0.02" material="mat_bay_a" contype="0" conaffinity="0"/>
    </body>
    <!-- Bay B: Automated Optical Inspection (AOI) -->
    <body name="bay_b_blue" pos="1.25 0.45 0.02">
      <geom type="cylinder" size="0.22 0.02" material="mat_bay_b" contype="0" conaffinity="0"/>
    </body>
    <!-- Bay C: Cleanroom QA Pass-Through -->
    <body name="bay_c_green" pos="0.0 1.60 0.02">
      <geom type="cylinder" size="0.22 0.02" material="mat_bay_c" contype="0" conaffinity="0"/>
    </body>

    <!-- Central Optical Inspection Spindle & Safety Light Barrier -->
    <body name="laser_spindle" pos="0.0 0.85 0.28">
      <geom type="cylinder" size="0.20 0.28" material="mat_laser_curtain"/>
    </body>

    <!-- 3-DOF Articulated Manipulator with Active Wrist (RRR) -->
    <body name="base_pedestal" pos="0 0 0.06">
      <geom type="cylinder" size="0.20 0.06" material="mat_carbon"/>
      <geom type="cylinder" size="0.14 0.08" pos="0 0 0.06" material="mat_titanium"/>

      <!-- Link 1 (Shoulder to Elbow) L1 = 0.90m -->
      <body name="link1" pos="0 0 0.12">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-2.618 2.618"/>
        <geom type="cylinder" size="0.09 0.06" material="mat_joint_cyan"/>
        <geom type="capsule" fromto="0 0 0 0.90 0 0" size="0.048" material="mat_carbon"/>
        
        <!-- Link 2 (Elbow to Wrist) L2 = 0.70m -->
        <body name="link2" pos="0.90 0 0">
          <joint name="joint2" type="hinge" axis="0 0 1" range="-2.356 2.356"/>
          <geom type="cylinder" size="0.07 0.05" material="mat_joint_cyan"/>
          <geom type="capsule" fromto="0 0 0 0.70 0 0" size="0.038" material="mat_carbon"/>

          <!-- Link 3: Articulated Wrist Joint L3 = 0.35m -->
          <body name="link3" pos="0.70 0 0">
            <joint name="joint3" type="hinge" axis="0 0 1" range="-2.094 2.094"/>
            <geom type="cylinder" size="0.055 0.04" material="mat_joint_accent"/>
            <geom type="capsule" fromto="0 0 0 0.35 0 0" size="0.028" material="mat_titanium"/>

            <!-- Tool Head & Parallel Servo Gripper -->
            <body name="end_effector" pos="0.35 0 0">
              <geom name="gripper_base" type="box" size="0.04 0.045 0.03" material="mat_titanium"/>
              <site name="ee_site" pos="0.05 0 0" size="0.015" rgba="0.02 0.75 0.90 1"/>
              
              <!-- Left Finger Jaw -->
              <body name="finger_left" pos="0.04 0.032 0">
                <joint name="joint_finger_left" type="slide" axis="0 1 0" range="0 0.03"/>
                <geom type="box" size="0.03 0.008 0.022" material="mat_titanium"/>
              </body>
              
              <!-- Right Finger Jaw -->
              <body name="finger_right" pos="0.04 -0.032 0">
                <joint name="joint_finger_right" type="slide" axis="0 1 0" range="-0.03 0"/>
                <geom type="box" size="0.03 0.008 0.022" material="mat_titanium"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Randomized Components (Spawned dynamic bodies) -->
    <body name="comp_1" pos="-0.65 0.95 0.05">
      <joint type="free"/>
      <geom type="box" size="0.04 0.04 0.04" material="mat_obj_crimson" mass="0.12"/>
    </body>

    <body name="comp_2" pos="0.65 1.15 0.05">
      <joint type="free"/>
      <geom type="sphere" size="0.045" material="mat_obj_emerald" mass="0.12"/>
    </body>

    <body name="comp_3" pos="-0.25 1.35 0.05">
      <joint type="free"/>
      <geom type="cylinder" size="0.04 0.04" material="mat_obj_amber" mass="0.12"/>
    </body>

    <body name="comp_4" pos="0.35 0.70 0.05">
      <joint type="free"/>
      <geom type="box" size="0.045 0.03 0.04" material="mat_obj_cobalt" mass="0.12"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor_joint1" joint="joint1" gear="1" ctrllimited="true" ctrlrange="-60 60"/>
    <motor name="motor_joint2" joint="joint2" gear="1" ctrllimited="true" ctrlrange="-50 50"/>
    <motor name="motor_joint3" joint="joint3" gear="1" ctrllimited="true" ctrlrange="-30 30"/>
    <position name="act_gripper" joint="joint_finger_left" kp="350" ctrlrange="0 0.03"/>
  </actuator>
</mujoco>
