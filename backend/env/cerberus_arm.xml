<mujoco model="cerberus_arm_3dof_manipulator">
  <compiler angle="radian" coordinate="local" meshdir="meshes" autolimits="true"/>
  
  <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81">
    <flag contact="enable"/>
  </option>

  <default>
    <joint damping="0.6" armature="0.03"/>
    <geom friction="1.2 0.005 0.0001" density="1200"/>
  </default>

  <visual>
    <headlight ambient="0.48 0.51 0.56" diffuse="0.82 0.85 0.90" specular="0.28 0.30 0.34"/>
    <rgba haze="0.88 0.92 0.96 1"/>
    <map znear="0.02" zfar="30" haze="0.12"/>
  </visual>

  <asset>
    <!-- Industrial Optical Workcell Grid Floor -->
    <texture name="grid_floor" type="2d" builtin="checker" width="512" height="512" rgb1="0.88 0.92 0.96" rgb2="0.82 0.87 0.92"/>
    <material name="mat_floor" texture="grid_floor" texrepeat="10 10" reflectance="0.06" roughness="0.78"/>
    
    <!-- Robot Link Materials -->
    <material name="mat_carbon" rgba="0.12 0.17 0.23 1" metallic="0.70" roughness="0.31"/>
    <material name="mat_titanium" rgba="0.70 0.76 0.83 1" metallic="0.82" roughness="0.20"/>
    <material name="mat_joint_cyan" rgba="0.02 0.55 0.68 1" emission="0.12"/>
    <material name="mat_joint_accent" rgba="0.78 0.48 0.08 1" emission="0.08"/>
    
    <!-- Industrial Sorting Bays -->
    <material name="mat_bay_a" rgba="0.86 0.22 0.24 0.68" emission="0.06"/> <!-- Bay A · SMT staging -->
    <material name="mat_bay_b" rgba="0.13 0.43 0.82 0.68" emission="0.06"/> <!-- Bay B · AOI inspection -->
    <material name="mat_bay_c" rgba="0.06 0.57 0.39 0.68" emission="0.06"/> <!-- Bay C · Cleanroom QA -->
    <material name="mat_laser_curtain" rgba="0.96 0.61 0.12 0.28" emission="0.12"/>

    <!-- Component Materials -->
    <material name="mat_obj_crimson" rgba="0.86 0.22 0.24 1" specular="0.45" roughness="0.28"/>
    <material name="mat_obj_cobalt" rgba="0.13 0.43 0.82 1" specular="0.45" roughness="0.28"/>
    <material name="mat_obj_emerald" rgba="0.06 0.57 0.39 1" specular="0.45" roughness="0.25"/>
    <material name="mat_obj_amber" rgba="0.88 0.48 0.06 1" specular="0.45" roughness="0.28"/>
    <material name="mat_obj_graphite" rgba="0.16 0.22 0.29 1" metallic="0.62" roughness="0.32"/>
    <material name="mat_obj_gold" rgba="0.78 0.55 0.18 1" metallic="0.78" roughness="0.24"/>
    <material name="mat_obj_glass" rgba="0.76 0.91 0.98 0.62" specular="0.72" roughness="0.08"/>

    <!-- Triangular prism mesh: two triangular faces and three optical facets. -->
    <mesh name="mesh_triangular_prism"
      vertex="-0.05 -0.035 -0.025  0.05 -0.035 -0.025  0 0.055 -0.025  -0.05 -0.035 0.025  0.05 -0.035 0.025  0 0.055 0.025"
      face="0 2 1  3 4 5  0 1 4  0 4 3  1 2 5  1 5 4  2 0 3  2 3 5"/>
  </asset>

  <worldbody>
    <!-- Precision Optical Breadboard Surface -->
    <geom name="floor" type="plane" size="3.5 3.5 0.1" material="mat_floor"/>
    
    <!-- Studio Overhead & Key Lights -->
    <light directional="true" pos="2 2 4.5" dir="-0.5 -0.5 -1" diffuse="0.95 0.95 1.0" specular="0.35 0.35 0.38"/>
    <light directional="true" pos="-2.5 -1.5 3.0" dir="0.8 0.5 -0.8" diffuse="0.42 0.48 0.56" specular="0.18 0.20 0.24"/>

    <!-- Industrial Sorting Station Bays -->
    <!-- Bay A: SMT Assembly Staging -->
    <body name="bay_a_red" pos="-1.25 0.45 0.02">
      <geom type="cylinder" size="0.22 0.02" material="mat_bay_a" contype="0" conaffinity="0"/>
    </body>
    <!-- Bay B: Automated Optical Inspection (AOI) -->
    <body name="bay_b_blue" pos="1.25 0.45 0.02">
      <geom type="cylinder" size="0.22 0.02" material="mat_bay_b" contype="0" conaffinity="0"/>
    </body>
    <!-- Bay C: Cleanroom QA Pass-Through -->
    <body name="bay_c_green" pos="0.0 1.60 0.02">
      <geom type="cylinder" size="0.22 0.02" material="mat_bay_c" contype="0" conaffinity="0"/>
    </body>

    <!-- Central Optical Inspection Spindle & Safety Light Barrier -->
    <body name="laser_spindle" pos="0.0 0.85 0.28">
      <geom type="cylinder" size="0.20 0.28" material="mat_laser_curtain"/>
    </body>

    <!-- 3-DOF Articulated Manipulator with Active Wrist (RRR) -->
    <body name="base_pedestal" pos="0 0 0.06">
      <geom type="cylinder" size="0.20 0.06" material="mat_carbon"/>
      <geom type="cylinder" size="0.14 0.08" pos="0 0 0.06" material="mat_titanium"/>

      <!-- Link 1 (Shoulder to Elbow) L1 = 0.90m -->
      <body name="link1" pos="0 0 0.12">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-2.618 2.618"/>
        <geom type="cylinder" size="0.09 0.06" material="mat_joint_cyan"/>
        <geom type="capsule" fromto="0 0 0 0.90 0 0" size="0.048" material="mat_carbon"/>
        
        <!-- Link 2 (Elbow to Wrist) L2 = 0.70m -->
        <body name="link2" pos="0.90 0 0">
          <joint name="joint2" type="hinge" axis="0 0 1" range="-2.356 2.356"/>
          <geom type="cylinder" size="0.07 0.05" material="mat_joint_cyan"/>
          <geom type="capsule" fromto="0 0 0 0.70 0 0" size="0.038" material="mat_carbon"/>

          <!-- Link 3: Articulated Wrist Joint L3 = 0.35m -->
          <body name="link3" pos="0.70 0 0">
            <joint name="joint3" type="hinge" axis="0 0 1" range="-2.094 2.094"/>
            <geom type="cylinder" size="0.055 0.04" material="mat_joint_accent"/>
            <geom type="capsule" fromto="0 0 0 0.35 0 0" size="0.028" material="mat_titanium"/>

            <!-- Tool Head & Parallel Servo Gripper -->
            <body name="end_effector" pos="0.35 0 0">
              <geom name="gripper_base" type="box" size="0.04 0.045 0.03" material="mat_titanium"/>
              <site name="ee_site" pos="0.05 0 0" size="0.015" rgba="0.02 0.75 0.90 1"/>
              
              <!-- Left Finger Jaw -->
              <body name="finger_left" pos="0.04 0.032 0">
                <joint name="joint_finger_left" type="slide" axis="0 1 0" range="0 0.03"/>
                <geom type="box" size="0.03 0.008 0.022" material="mat_titanium"/>
              </body>
              
              <!-- Right Finger Jaw -->
              <body name="finger_right" pos="0.04 -0.032 0">
                <joint name="joint_finger_right" type="slide" axis="0 1 0" range="-0.03 0"/>
                <geom type="box" size="0.03 0.008 0.022" material="mat_titanium"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Randomized Components (Spawned dynamic bodies) -->
    <body name="micro_module_cube" pos="-0.65 0.95 0.05">
      <joint type="free"/>
      <geom name="ic_graphite_package" type="box" size="0.041 0.041 0.035" material="mat_obj_graphite" mass="0.12"/>
      <geom name="ic_crimson_lid" type="box" size="0.029 0.029 0.006" pos="0 0 0.039" material="mat_obj_crimson" contype="0" conaffinity="0"/>
      <geom name="ic_alignment_mark" type="box" size="0.011 0.002 0.001" pos="0 0 0.046" material="mat_obj_gold" contype="0" conaffinity="0"/>
      <geom name="ic_lead_north" type="box" size="0.018 0.004 0.003" pos="0 0.044 -0.018" material="mat_obj_gold" contype="0" conaffinity="0"/>
      <geom name="ic_lead_south" type="box" size="0.018 0.004 0.003" pos="0 -0.044 -0.018" material="mat_obj_gold" contype="0" conaffinity="0"/>
    </body>

    <body name="quartz_focusing_lens" pos="0.65 1.15 0.05">
      <joint type="free"/>
      <geom name="lens_quartz_shell" type="sphere" size="0.046" material="mat_obj_glass" mass="0.12"/>
      <geom name="lens_emerald_coating" type="sphere" size="0.041" material="mat_obj_emerald" contype="0" conaffinity="0"/>
      <geom name="lens_inner_element" type="sphere" size="0.018" pos="-0.01 0.008 0.031" material="mat_obj_glass" contype="0" conaffinity="0"/>
    </body>

    <body name="dispersive_prism" pos="-0.25 1.35 0.05">
      <joint type="free"/>
      <geom name="prism_glass_body" type="mesh" mesh="mesh_triangular_prism" material="mat_obj_glass" mass="0.12"/>
      <geom name="prism_amber_facet" type="box" size="0.009 0.002 0.002" pos="0 0.02 0.027" material="mat_obj_amber" contype="0" conaffinity="0"/>
      <geom name="prism_corner_a" type="sphere" size="0.006" pos="-0.045 -0.029 0.03" material="mat_obj_gold" contype="0" conaffinity="0"/>
      <geom name="prism_corner_b" type="sphere" size="0.006" pos="0.045 -0.029 0.03" material="mat_obj_gold" contype="0" conaffinity="0"/>
      <geom name="prism_corner_c" type="sphere" size="0.006" pos="0 0.05 0.03" material="mat_obj_gold" contype="0" conaffinity="0"/>
    </body>

    <body name="fiducial_sensor_star" pos="0.35 0.70 0.05">
      <joint type="free"/>
      <geom name="sensor_star_hub" type="sphere" size="0.026" material="mat_obj_cobalt" mass="0.12"/>
      <geom name="sensor_star_arm_1" type="capsule" fromto="0 0 0 0 0.065 0" size="0.012" material="mat_obj_cobalt" contype="0" conaffinity="0"/>
      <geom name="sensor_star_arm_2" type="capsule" fromto="0 0 0 0.062 0.02 0" size="0.012" material="mat_obj_cobalt" contype="0" conaffinity="0"/>
      <geom name="sensor_star_arm_3" type="capsule" fromto="0 0 0 0.038 -0.052 0" size="0.012" material="mat_obj_cobalt" contype="0" conaffinity="0"/>
      <geom name="sensor_star_arm_4" type="capsule" fromto="0 0 0 -0.038 -0.052 0" size="0.012" material="mat_obj_cobalt" contype="0" conaffinity="0"/>
      <geom name="sensor_star_arm_5" type="capsule" fromto="0 0 0 -0.062 0.02 0" size="0.012" material="mat_obj_cobalt" contype="0" conaffinity="0"/>
      <geom name="sensor_star_optic" type="sphere" size="0.012" pos="0 0 0.026" material="mat_obj_glass" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor_joint1" joint="joint1" gear="1" ctrllimited="true" ctrlrange="-60 60"/>
    <motor name="motor_joint2" joint="joint2" gear="1" ctrllimited="true" ctrlrange="-50 50"/>
    <motor name="motor_joint3" joint="joint3" gear="1" ctrllimited="true" ctrlrange="-30 30"/>
    <position name="act_gripper" joint="joint_finger_left" kp="350" ctrlrange="0 0.03"/>
  </actuator>
</mujoco>
